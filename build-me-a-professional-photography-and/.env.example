# Zoho Mail SMTP delivery for all inquiry forms (server-only)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
ZOHO_SMTP_SECURE=true
ZOHO_SMTP_USER=
ZOHO_SMTP_PASSWORD=
CONTACT_TO_EMAIL=
# Must be the authenticated Zoho mailbox or an alias permitted by that account.
CONTACT_FROM_EMAIL=

# Optional. When configured, wedding conversion events are pushed to GTM's dataLayer.
# Map the form_success event to GA4 and import it as a Google Ads conversion.
NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID=

# Public wedding gallery. The CTA is hidden when this is not configured.
NEXT_PUBLIC_PIXIESET_GALLERY_URL=https://brandonmediagroupllc.pixieset.com/weddingpicture/

# Optional. Displays a consultation-booking CTA after a successful inquiry.
NEXT_PUBLIC_CONSULTATION_URL=
